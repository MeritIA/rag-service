# ---------------------------------------------------------------------------
# MeritIA rag-service — plantilla de variables de entorno
# Copia a `.env` y rellena. `.env` esta en .gitignore y NUNCA se sube.
# Igual que el ai-service: no hay base de datos ni claves del backend aqui.
# ---------------------------------------------------------------------------

APP_ENV=development
PORT=3200

# Secreto compartido con el backend (alli: AI_SERVICE_API_KEY). Minimo 32 caracteres:
#   python -c "import secrets; print(secrets.token_hex(32))"
CLAVE_DE_ACCESO=

# gemini | simulado.  El simulado responde con el mejor fragmento, sin modelo.
PROVEEDOR_IA=simulado
# gemini | hash.  `hash` es local, sin red y NO es semantico: solo desarrollo/pruebas.
EMBEDDINGS=hash
# Ambos simulado/hash estan PROHIBIDOS con APP_ENV=production.

# Solo si PROVEEDOR_IA o EMBEDDINGS = gemini. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash
GEMINI_MODELO_EMBEDDINGS=gemini-embedding-001
EMBEDDINGS_DIMENSION=768

TIEMPO_MAXIMO_MS=30000

# Recuperacion hibrida (BM25 + vectores, fusion RRF)
K_CANDIDATOS=20
K_FINAL=4
PESO_LEXICO=1.0
PESO_SEMANTICO=1.0
RRF_K=60
